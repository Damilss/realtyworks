# pnpm lockfile — managed by pnpm, not Prettier
pnpm-lock.yaml

# Markdown is hand-maintained (CLAUDE.md, README.md, AGENTS.md, docs/)
*.md

# Generated / build output (also covered by .gitignore)
.next/
next-env.d.ts

# Supabase CLI scratch dir (git-ignored via supabase/.gitignore, which
# Prettier doesn't read — without this line, format:check fails locally
# whenever the local stack has run)
supabase/.temp/

# Istanbul's generated coverage report (issue #28) — same reason as above.
# It happens to be Prettier-clean today, so leaving it out would work until an
# Istanbul version bump silently broke format:check for anyone who had run
# coverage locally.
coverage/
