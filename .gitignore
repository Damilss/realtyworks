# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
# pnpm's local content-addressable store — a per-machine build artifact,
# regenerated on `pnpm install`. Never commit it.
.pnpm-store

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the committed template, which documents every required var
# (CLAUDE.md §3/§5) and holds no real values.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

#mac stuff
.DS_Store

# git worktrees checked out inside the repo. Without this, `git add -A` from the
# repo root records the nested checkout as a gitlink (mode 160000) — a phantom
# submodule with no .gitmodules entry, which breaks fresh clones.
/wt-*/

# Claude Code's local state. Every current occupant is per-machine rather than
# project configuration: `settings.json` (harness behaviour, e.g. whether a
# background job edits this checkout directly), a scheduler lock, and
# `worktrees/` — which is the same gitlink hazard the `/wt-*/` rule above
# exists to prevent, just at a path that rule does not match. Negate a specific
# file here if shared project settings are ever worth committing.
/.claude/

# editor swap files
*.swp
*.swo
