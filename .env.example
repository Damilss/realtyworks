# TEMPLATE — THIS FILE IS TRACKED BY GIT (the `!.env.example` negation in
# .gitignore). Anything you type after an `=` below gets committed. Do NOT put
# real values here: copy this file to .env.local (which is gitignored) and fill
# it in THERE. Leave the assignments below empty.
#
# Local values come from the running local stack:
#   pnpm exec supabase start
#   pnpm exec supabase status
#
# The two NEXT_PUBLIC_ variables below are public on purpose — they are safe to
# ship to the browser. The publishable key is not a secret: it grants nothing
# beyond what RLS allows for the caller's session.

# API_URL from `supabase status` (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=

# PUBLISHABLE_KEY from `supabase status` (local: sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET_KEY from `supabase status` (local: sb_secret_...).
#
# NOT NEXT_PUBLIC_, and it never can be: `next build` inlines every
# NEXT_PUBLIC_* value into the browser bundle, and this key bypasses RLS
# completely (CLAUDE.md §2). Server-side only — it is read by
# src/lib/supabase/admin.ts and by nothing else.
#
# Two writes need it, both unreachable from the Data API by design: attachment
# metadata (no client INSERT grant) and vendors.profile_id (no client write
# grant). The app builds and runs without it; only the vendor invite and the
# photo upload fail.
SUPABASE_SECRET_KEY=
